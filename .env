#!/usr/bin/env bash

# Flexible bash function to run containers, defaults to use docker
run_container() {
  container_run_exec=("$@")
  [[ ${#container_run_exec[@]} -eq 0 ]] && container_run_exec=(docker)

  run_cmd=( "${container_run_exec[@]}" run -it --rm
    -v $(pwd)/conf:${HOME}/.config/beets
    -v $(pwd):/work
    beets:local
    bash)

  echo "${run_cmd[@]}"
  "${run_cmd[@]}"
}


# Use docker to build an image
beets_build_docker() {
  bash build-image.sh
}

# Use docker to run a container
beets_docker() {
  run_container
}

# Use nerdctl to build an image
beets_build_nerd() {
  bash build-image.sh sudo nerdctl
}

# Use nerdctl to run a container
beets_nerd() {
  run_container sudo nerdctl
}
